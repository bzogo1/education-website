---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Privacy Policy - Tailcast" noindex>
  <div class="content-container py-12 lg:py-20">
    <h1 class="block-title mb-6">Privacy Policy</h1>
    <p class="text-secondaryText text-base leading-relaxed mb-6">
      This is the privacy policy page for Tailcast. Your personal information
      is collected and used in accordance with this policy.
    </p>
    <h2 class="content-title mb-3">Information We Collect</h2>
    <p class="text-secondaryText text-base leading-relaxed mb-6">
      We may collect your name, email address, and other details you provide
      when creating an account or contacting us.
    </p>
    <h2 class="content-title mb-3">How We Use Your Information</h2>
    <p class="text-secondaryText text-base leading-relaxed mb-6">
      Your information is used to provide and improve our services, communicate
      with you, and optionally send marketing updates if you consent to them.
    </p>
    <h2 class="content-title mb-3">Contact Us</h2>
    <p class="text-secondaryText text-base leading-relaxed">
      Questions about this policy? Reach us at mailto:bzogovic7@gmail.com
    </p>
  </div>
</Layout>
