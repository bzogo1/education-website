  .mode-section, .steps-section, .templates-section { width: min(1160px, calc(100% - 48px)); margin: auto; }.mode-section { padding: 108px 0 150px; border-top: 1px solid var(--line); }.section-heading { display: flex; justify-content: space-between; align-items: end; }.section-heading h2, .steps-intro h2, .template-head h2 { font-size: clamp(39px, 4.5vw, 61px); }.mode-switch { display: flex; margin-top: 62px; border-bottom: 1px solid var(--line); }.mode-tab { padding: 15px 25px 15px 0; margin-right: 35px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: #888b83; font: 11px Inter; cursor: pointer; }.mode-tab.active { border-color: var(--coral); color: var(--ink); font-weight: 700; }.mode-content { display: grid; grid-template-columns: 100px 1fr auto; gap: 22px; align-items: start; max-width: 650px; padding-top: 47px; }.mode-number { color: var(--coral); font: 42px 'Playfair Display', Georgia, serif; }.mode-content h3 { margin: 0 0 11px; font-size: 21px; }.mode-content p { max-width: 480px; margin: 0; color: #777a71; font-size: 14px; line-height: 1.7; }.round-arrow { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); text-decoration: none; }
