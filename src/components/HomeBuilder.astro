-radius: 2px; background: #1c2924; color: white; font: 7px Inter; }.mock-site-hero { margin: 62px 0 0 13%; }.tiny-label { color: #7c938a; font-size: 7px; font-weight: 800; letter-spacing: .15em; }.mock-site-hero h2 { margin: 13px 0; color: #1d2e27; font-size: clamp(29px, 4vw, 48px); line-height: .91; }.mock-site-hero h2 i { color: #c56b52; font-family: 'Playfair Display', Georgia, serif; }.mock-site-hero p { max-width: 170px; color: #6f7f77; font-size: 8px; line-height: 1.5; }.mock-link { margin-top: 9px; padding: 0; border: 0; background: none; color: #1d2e27; font: 700 8px Inter; }.mock-site-footer { display: flex; justify-content: space-between; margin-top: 47px; color: #83978e; font-size: 7px; }.footer-line { width: 46%; height: 1px; background: #afc2b9; }
