---
import FacebookIcon from '../assets/icons/FacebookIcon.astro';
import GithubIcon from '../assets/icons/GithubIcon.astro';
import TailcastLogo from '../assets/logos/TailcastLogo.astro';
import TwitterIcon from '../assets/icons/TwitterIcon.astro';

const footerData = [
  { title: 'Overview', href: '/#home' },
  { title: 'Features', href: '/services' },
  { title: 'Pricing', href: '/services#pricing' },
  { title: 'Explore', href: '/explore' },
  { title: 'Help', href: '/contact' },
  { title: 'Privacy', href: '/privacy' },
];
---

<footer aria-label="Site footer">
  <div class="border-mainBorderDarker border-t bg-bgDark1">
    <div class="content-container py-12 lg:py-16">
      <div class="flex flex-col items-start justify-between gap-x-8 gap-y-10 sm:flex-row">
        <div>
          <a href="/#home" class="flex items-center" aria-label="Tailcast home">
            <span class="mr-2 text-5xl text-white"><TailcastLogo /></span>
            <span class="text-xl font-bold text-white">Tailcast</span>
          </a>
          <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
            {footerData.map(({ title, href }) => (
              <li>
                <a class="text-sm text-gray-400 transition hover:text-white" href={href}>{title}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="w-full max-w-xs">
          <h2 class="font-medium text-white">Stay up to date</h2>
          <form class="mt-6 flex items-center gap-2" onsubmit="return false">
            <label for="footer-email" class="sr-only">Enter your email</label>
            <input
              id="footer-email"
              class="form-input h-11 min-w-0 py-0 text-sm"
              placeholder="Enter your email"
              type="email"
            />
            <button
              class="bg-primaryColor text-black h-11 shrink-0 cursor-pointer rounded-lg px-4 text-sm font-semibold transition hover:bg-[#b8dcff]"
              type="button"
              data-open-modal
            >Subscribe</button>
          </form>
        </div>
      </div>

      <div class="border-mainBorderDarker mt-10 border-t pt-8 sm:mt-12">
        <div class="flex flex-col-reverse items-center justify-between gap-y-5 sm:flex-row">
          <span class="text-sm text-gray-400">
            &copy; {new Date().getFullYear()} <a class="hover:text-white" href="/#home">Tailcast</a>. All rights reserved.
          </span>

          <div class="flex items-center gap-5 text-gray-400">
            <a class="transition hover:text-white" href="mailto:hello@tailcast.dev" aria-label="Email Tailcast">
              <span class="text-lg" aria-hidden="true">@</span>
            </a>
            <a class="transition hover:text-white" href="#" aria-label="Tailcast on Twitter"><TwitterIcon /></a>
            <a class="transition hover:text-white" href="#" aria-label="Tailcast on Facebook"><FacebookIcon /></a>
            <a
              class="transition hover:text-white"
              href="https://github.com/matt765/Tailcast"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tailcast on GitHub (opens in new tab)"><GithubIcon /></a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
