---
import cloudflareIcon from '../assets/icons/brand/cloudflare.svg';
import githubIcon from '../assets/icons/brand/github.svg';
import googleCloudIcon from '../assets/icons/brand/google-cloud.svg';
import supabaseIcon from '../assets/icons/brand/supabase.svg';
import vercelIcon from '../assets/icons/brand/vercel.svg';
---

<section class="sync-showcase" aria-labelledby="sync-showcase-title">
  <div class="content-container sync-showcase__inner">
    <div class="sync-showcase__copy">
      <span class="block-subtitle sync-showcase__eyebrow">One connected workspace</span>
      <h1 id="sync-showcase-title">Sync your workflow across every app</h1>
      <p>
        Bring your favorite tools together in one calm, intelligent workspace. Keep every signal
        connected, so your team can move from idea to impact without losing the thread.
      </p>
      <div class="sync-showcase__meta" aria-label="Integration status">
        <span class="sync-showcase__status-dot"></span>
        <span>Always in sync</span>
      </div>
    </div>

    <div class="sync-showcase__visual" aria-label="Connected apps network illustration" role="img">
      <div class="sync-showcase__halo sync-showcase__halo--outer"></div>
      <div class="sync-showcase__halo sync-showcase__halo--inner"></div>
      <svg class="sync-showcase__lines" viewBox="0 0 520 360" aria-hidden="true">
        <path d="M260 180 C190 180 160 90 90 74" />
        <path d="M260 180 C180 180 145 180 70 180" />
        <path d="M260 180 C190 180 160 270 90 286" />
        <path d="M260 180 C330 180 360 90 430 74" />
        <path d="M260 180 C340 180 375 180 450 180" />
      </svg>

      <div class="sync-showcase__core" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M7.5 8.5a4.5 4.5 0 0 1 8.42-2.2L18 8.5M16.5 15.5a4.5 4.5 0 0 1-8.42 2.2L6 15.5" />
          <path d="M18 5.5v3h-3M6 18.5v-3h3" />
        </svg>
      </div>

      <div class="sync-showcase__node sync-showcase__node--slack">
        <img src={cloudflareIcon} alt="Cloudflare" />
      </div>
      <div class="sync-showcase__node sync-showcase__node--notion">
        <img src={githubIcon} alt="GitHub" />
      </div>
      <div class="sync-showcase__node sync-showcase__node--drive">
        <img src={googleCloudIcon} alt="Google Cloud" />
      </div>
      <div class="sync-showcase__node sync-showcase__node--linear">
        <img src={supabaseIcon} alt="Supabase" />
      </div>
      <div class="sync-showcase__node sync-showcase__node--figma">
        <img src={vercelIcon} alt="Vercel" />
      </div>
    </div>
  </div>
</section>

<style>
  .sync-showcase {
    position: relative;
    overflow: hidden;
    padding: 9rem 0 6rem;
    background:
      radial-gradient(circle at 78% 45%, rgb(145 198 255 / 0.08), transparent 22rem),
      linear-gradient(180deg, rgb(13 14 14) 0%, rgb(7 8 8) 100%);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }

  .sync-showcase__inner {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: center;
    gap: 3rem;
  }

  .sync-showcase__copy {
    max-width: 34rem;
  }

  .sync-showcase__eyebrow {
    margin-bottom: 1.5rem;
    color: rgb(145 198 255);
  }

  .sync-showcase h1 {
    margin: 0 0 1.5rem;
    color: rgb(248 248 245);
    font-size: clamp(2.6rem, 6vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .sync-showcase p {
    max-width: 31rem;
    color: rgb(166 169 165);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .sync-showcase__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    color: rgb(177 211 242);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sync-showcase__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgb(145 198 255);
    box-shadow: 0 0 0 0.3rem rgb(145 198 255 / 0.12), 0 0 1rem rgb(145 198 255 / 0.8);
  }

  .sync-showcase__visual {
    position: relative;
    min-height: 23rem;
  }

  .sync-showcase__halo,
  .sync-showcase__lines {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
  }

  .sync-showcase__halo {
    border: 1px solid rgb(145 198 255 / 0.1);
    border-radius: 50%;
  }

  .sync-showcase__halo--outer {
    width: min(26rem, 100%);
    aspect-ratio: 1;
    box-shadow: inset 0 0 4rem rgb(145 198 255 / 0.04);
  }

  .sync-showcase__halo--inner {
    width: 13rem;
    height: 13rem;
    border-color: rgb(145 198 255 / 0.16);
    box-shadow: 0 0 3rem rgb(145 198 255 / 0.08), inset 0 0 2rem rgb(145 198 255 / 0.06);
  }

  .sync-showcase__lines {
    width: min(32.5rem, 100%);
    height: 22.5rem;
    overflow: visible;
  }

  .sync-showcase__lines path {
    fill: none;
    stroke: rgb(145 198 255 / 0.34);
    stroke-width: 1;
    stroke-dasharray: 4 7;
    animation: sync-dash 7s linear infinite;
  }

  .sync-showcase__core,
  .sync-showcase__node {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(145 198 255 / 0.22);
    color: rgb(248 248 245);
    background: linear-gradient(145deg, rgb(35 38 35), rgb(18 20 20));
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.32), inset 0 1px rgb(255 255 255 / 0.08);
  }

  .sync-showcase__core {
    top: 50%;
    left: 50%;
    width: 5rem;
    height: 5rem;
    border-radius: 1.35rem;
    transform: translate(-50%, -50%);
    color: rgb(145 198 255);
    box-shadow: 0 0 2.5rem rgb(145 198 255 / 0.2), 0 1rem 2rem rgb(0 0 0 / 0.32);
    animation: sync-pulse 4s ease-in-out infinite;
  }

  .sync-showcase__core svg {
    width: 2rem;
    height: 2rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .sync-showcase__node {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.9rem;
    font-size: 1.1rem;
    font-weight: 700;
    animation: sync-float 5s ease-in-out infinite;
  }

  .sync-showcase__node img {
    width: 1.7rem;
    height: 1.7rem;
    object-fit: contain;
    fill: currentColor;
  }

  .sync-showcase__node--slack { top: 8%; left: 12%; color: #f7b4d8; }
  .sync-showcase__node--notion { top: 42%; left: 3%; color: #f8f8f5; animation-delay: -1s; }
  .sync-showcase__node--drive { bottom: 8%; left: 12%; color: #a4d7b0; animation-delay: -2s; }
  .sync-showcase__node--linear { top: 8%; right: 12%; color: #c8b8ff; animation-delay: -0.5s; }
  .sync-showcase__node--figma { top: 42%; right: 3%; color: #ffb19d; animation-delay: -1.5s; }
  .sync-showcase__node--mail { right: 12%; bottom: 8%; color: #91c6ff; animation-delay: -2.5s; }

  @keyframes sync-dash { to { stroke-dashoffset: -44; } }
  @keyframes sync-pulse { 50% { transform: translate(-50%, -50%) scale(1.04); } }
  @keyframes sync-float { 50% { transform: translateY(-0.45rem); } }

  @media (min-width: 768px) {
    .sync-showcase__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(30rem, 1.15fr);
      gap: 4rem;
    }

    .sync-showcase__visual {
      min-height: 31rem;
    }
  }

  @media (max-width: 767px) {
    .sync-showcase {
      padding-top: 8rem;
    }

    .sync-showcase__visual {
      min-height: 20rem;
    }
  }
</style>