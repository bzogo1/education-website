{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --host localhost --port 4321",
      "startServerReadyPattern": "http://localhost:4321",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/about/",
        "http://localhost:4321/features",
        "http://localhost:4321/blog/",
        "http://localhost:4321/blog/predictive-analytics-startups/",
        "http://localhost:4321/explore/",
        "http://localhost:4321/explore/senior-frontend-engineer/",
        "http://localhost:4321/signup/",
        "http://localhost:4321/contact/",
        "http://localhost:4321/privacy/",
        "http://localhost:4321/terms-of-service/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": ["--no-sandbox"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.75 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
